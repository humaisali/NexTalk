# ─── Server ───────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Database ─────────────────────────────────────────────────────
# Get from: https://cloud.mongodb.com → Create Cluster → Connect
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/nextalk?retryWrites=true&w=majority

# ─── Auth ─────────────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_here_minimum_32_characters

# ─── AI ───────────────────────────────────────────────────────────
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_google_gemini_api_key

# ─── CORS ─────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
# Production: your Vercel URL (no trailing slash)
# Development: http://localhost:5173
CLIENT_ORIGIN=http://localhost:5173
